# Exemple de configuration d'environnement du vivarium (Phase 0).
# Copier vers .env (hors dépôt) ou exporter dans le shell. Aucun secret ici.

# Répertoires de travail
VIVARIUM_DATA_DIR=data
VIVARIUM_LOG_DIR=logs
VIVARIUM_CONFIG_DIR=config

# Niveau de journalisation : DEBUG | INFO | WARNING | ERROR
VIVARIUM_LOG_LEVEL=INFO

# LLM local (LM Studio). Le modèle est chargé par LM Studio, jamais par ce dépôt.
# L'adaptateur refuse toute URL distante.
VIVARIUM_LLM_BASE_URL=http://127.0.0.1:1234/v1
# Recopier l'identifiant exact du modèle chargé, visible dans LM Studio.
VIVARIUM_LLM_MODEL=
# Optionnel : seulement si l'authentification du serveur LM Studio est activée.
# VIVARIUM_LLM_API_TOKEN=
VIVARIUM_LLM_TIMEOUT_SECONDS=45
